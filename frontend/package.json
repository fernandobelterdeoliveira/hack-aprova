{
  "name": "morgan-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node --max-old-space-size=4096 node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:hybrid": "node scripts/hybrid-pipeline-test.mjs",
    "test:connectors": "node scripts/connectors-test.mjs",
    "test:connector-storage": "node scripts/connector-storage-test.mjs",
    "test:mcp": "node scripts/mcp-test.mjs",
    "test:cases-operational": "node scripts/operational-case-test.mjs",
    "seed:case-operational": "node scripts/seed-operational-case.mjs",
    "connectors:scheduler": "node --env-file=.env.local scripts/connector-scheduler.mjs",
    "jobs:worker": "node --require ./scripts/tsx-windows-shim.cjs --env-file=.env.local --import tsx scripts/job-worker.ts",
    "jobs:once": "node --require ./scripts/tsx-windows-shim.cjs --env-file=.env.local --import tsx scripts/job-worker.ts --once",
    "test:jobs": "node --require ./scripts/tsx-windows-shim.cjs --env-file=.env.local --import tsx scripts/background-jobs-test.ts",
    "test:security": "node --env-file=.env.local scripts/workspace-isolation-test.mjs"
  },
