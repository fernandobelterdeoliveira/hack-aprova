# PostgreSQL used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lexiloop"

# Python structured-extraction service. Omit to use deterministic local rules.
INGESTION_EXTRACTOR_URL="http://localhost:8000"

# Existing integrations
PYTHON_BACKEND_URL="http://localhost:8000"
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Hybrid AI routing. External providers are optional and deterministic fallback
# remains available when they are missing or unavailable.
AI_DECISION_PROVIDER="deterministic"
AI_AUTO_APPLY_ENABLED="false"

# Explainable case-association thresholds
ASSOCIATION_AUTO_SUGGEST="0.85"
ASSOCIATION_NEEDS_REVIEW="0.60"
ASSOCIATION_AMBIGUOUS_MARGIN="0.12"
ASSOCIATION_NO_MATCH="0.35"

# Jev / TypeSafe System One (optional; uses an explicit mock without a key)
JEV_API_KEY=""
JEV_BASE_URL="https://api.typesafe.ai"
JEV_MODEL="jev-latest"

# OpenAI Responses API and embeddings (optional)
OPENAI_API_KEY=""
OPENAI_DECISION_MODEL=""
OPENAI_DECISION_MODEL_VERSION=""
OPENAI_CASE_INTELLIGENCE_MODEL=""
OPENAI_CASE_INTELLIGENCE_MODEL_VERSION=""
EMBEDDING_PROVIDER="local"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Public connector URLs. APP_PUBLIC_URL must be HTTPS and reachable by Google,
# Microsoft and Meta; localhost is only suitable for the local interface.
APP_BASE_URL="http://localhost:3001"
APP_PUBLIC_URL=""

# Identidade do painel (Auth0). Sem estas variáveis, o desenvolvimento local
# continua usando o perfil e workspace locais. Nunca use o modo local em produção.
AUTH0_DOMAIN=""
AUTH0_CLIENT_ID=""
AUTH0_CLIENT_SECRET=""
AUTH0_SECRET=""
AUTH0_MCP_AUDIENCE=""
ALLOW_LOCAL_AUTH="false"

# MCP do LexiLoop. MCP_PUBLIC_URL deve ser HTTPS para conexão pelo ChatGPT.
# MCP_LOCAL_TOKEN habilita testes locais; se estiver vazio, o MCP local fica fechado.
MCP_PUBLIC_URL=""
MCP_LOCAL_TOKEN=""

# Encryption and OAuth state signing (use independent random secrets in production)
CONNECTOR_ENCRYPTION_KEY=""
CONNECTOR_STATE_SECRET=""

# WhatsApp Business Cloud API inbound webhook
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_GRAPH_VERSION="v23.0"

# Cópia permanente privada dos anexos. Use local apenas em desenvolvimento.
OBJECT_STORAGE_PROVIDER="local"
LOCAL_STORAGE_PATH="./data/connector-storage"
CONNECTOR_MAX_FILE_BYTES="26214400"
STORAGE_SIGNING_SECRET=""
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# Confirmação automática fixa e de baixo risco. Desabilitada por padrão.
CONNECTOR_AUTO_ACK_ENABLED="false"

# Renovação automática de watches/subscriptions.
CONNECTOR_CRON_SECRET=""
CONNECTOR_RENEW_INTERVAL_MS="21600000"

# PostgreSQL-backed background worker
JOB_WORKER_CONCURRENCY="2"
JOB_POLL_INTERVAL_MS="1000"
JOB_MAX_ATTEMPTS="3"
JOB_TIMEOUT_MS="300000"
CASE_ANALYSIS_TIMEOUT_MS="600000"
JOB_STALE_AFTER_MS="900000"

# Google OAuth, Gmail Pub/Sub and Drive change channels
GOOGLE_CONNECTOR_CLIENT_ID=""
GOOGLE_CONNECTOR_CLIENT_SECRET=""
GOOGLE_CONNECTOR_REDIRECT_URI="http://localhost:3001/api/connectors/google/callback"
GOOGLE_GMAIL_PUBSUB_TOPIC=""
GOOGLE_PUBSUB_OIDC_AUDIENCE=""
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=""

# Microsoft Graph / Outlook
MICROSOFT_CONNECTOR_CLIENT_ID=""
MICROSOFT_CONNECTOR_CLIENT_SECRET=""
MICROSOFT_CONNECTOR_TENANT_ID="common"
MICROSOFT_CONNECTOR_REDIRECT_URI="http://localhost:3001/api/connectors/microsoft/callback"

# Número utilizado pelo chat WhatsApp e roteamento de webhooks
# run_backend.py carrega GOOGLE_API_KEY a partir de .env.local
GOOGLE_API_KEY=
